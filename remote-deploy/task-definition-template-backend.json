{
  "family": "${BACKEND_FAMILY}",
  "networkMode": "awsvpc",
  "executionRoleArn": "${BACKEND_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${BACKEND_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${BACKEND_CONTAINER_NAME}",
      "image": "${BACKEND_IMAGE_NAME}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": "${BACKEND_CONTAINER_PORT}",
          "hostPort": "${BACKEND_CONTAINER_PORT}",
          "protocol": "tcp",
          "name": "${BACKEND_CONTAINER_NAME}-${BACKEND_CONTAINER_PORT}-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "PORT", "value": "${BACKEND_CONTAINER_PORT}" },
        { "name": "POSTGRES_URL", "value": "${BACKEND_POSTGRES_URL}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${BACKEND_FAMILY}",
          "awslogs-create-group": "true",
          "awslogs-region": "${BACKEND_AWS_DEFAULT_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
